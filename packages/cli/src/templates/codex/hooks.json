{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "trellis hook workflow --platform codex",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "trellis hook subagent --platform codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
