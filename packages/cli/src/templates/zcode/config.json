{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "matcher": "startup|clear|compact",
          "hooks": [
            {
              "type": "command",
              "command": "trellis hook session --platform zcode",
              "timeout": 30
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "trellis hook workflow --platform zcode",
              "timeout": 15
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Agent|Task",
          "hooks": [
            {
              "type": "command",
              "command": "trellis hook subagent --platform zcode",
              "timeout": 30
            }
          ]
        }
      ]
    }
  }
}
