{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "trellis hook subagent --platform cursor",
        "matcher": "Task|Subagent",
        "timeout": 30
      }
    ],
    "sessionStart": [
      {
        "command": "trellis hook session --platform cursor",
        "timeout": 30
      }
    ]
  }
}
