{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "trellis hook session --platform copilot",
        "timeout": 30
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "trellis hook workflow --platform copilot",
        "powershell": "trellis hook workflow --platform copilot",
        "timeoutSec": 15
      }
    ]
  }
}
