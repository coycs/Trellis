{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "trellis hook session --platform gemini",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "trellis hook workflow --platform gemini",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
