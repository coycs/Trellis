{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "trellis hook session --platform trae",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "trellis hook workflow --platform trae",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
